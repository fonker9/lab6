  lines:
  - speakerName: "\u0412\u0435\u0440\u043E\u043D\u0438\u043A\u0430"
    text: "\u041F\u0440\u0438\u0432\u0435\u0442! "
  - speakerName: "\u0412\u0435\u0440\u043E\u043D\u0438\u043A\u0430"
    text: "\u041C\u043D\u0435, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u0417\u0435\u043B\u044C\u0435 \u0411\u043E\u0434\u0440\u043E\u0441\u0442\u0438. "
  - speakerName: "\u0412\u0435\u0440\u043E\u043D\u0438\u043A\u0430"
    text: "\u0421 \u043D\u043E\u0433 \u0432\u0430\u043B\u044E\u0441\u044C \u043E\u0442
      \u044D\u0442\u0438\u0445 \u043D\u043E\u0447\u043D\u044B\u0445 \u043F\u043E\u043B\u0435\u0442\u043E\u0432. "
